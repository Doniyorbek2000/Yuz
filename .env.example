# Template only — copy to apps/backend/.env (git-ignored) for local development.
# The mobile app needs no secrets. Generate secrets with: openssl rand -hex 32

# --- Backend (apps/backend) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://yuz:change-me@localhost:5432/yuz
REDIS_URL=redis://localhost:6379/0
# >= 32 characters
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# >= 32 characters; shared with the AI worker only
WORKER_TOKEN=
STORAGE_DIR=./storage
CORS_ORIGINS=
WELCOME_CREDITS=3
MAX_UPLOAD_MB=12
CLOUD_AI_CONSENT_VERSION=2026-10
RESULT_RETENTION_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Store verification (not configured: purchases answer 503) ---
# Requires App Store Server API and Google Play Developer API credentials
# issued by the account owner; never commit them.

# --- AI worker (Phase 6; disabled unless configured) ---
AI_PROVIDER=none
AI_PROVIDER_API_KEY=

# --- Monitoring (Phase 8) ---
SENTRY_DSN=
