# Copy to deploy/.env (git-ignored). Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# >= 32 characters
JWT_SECRET=
# >= 32 characters; shared with the AI worker only
WORKER_TOKEN=
# Comma-separated origins allowed to call the API from a browser (admin panel)
CORS_ORIGINS=
CLOUD_AI_CONSENT_VERSION=2026-10
