{
  "name": "yuz-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Yuz API: accounts, consent, credits, purchases and cloud AI jobs.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "bullmq": "6.3.14",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "multer": "2.5.0",
    "js-yaml": "5.4.3"
  }
}
