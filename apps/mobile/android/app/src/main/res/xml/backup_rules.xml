<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The session tokens are encrypted with a Keystore key
     that never leaves the device, so a restored copy could not be decrypted:
     keep them out of backups (the user simply signs in again). -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
